{
  "description": "Receive complete plan bodies through submit --stdin before finalization; preserve native authorization.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/review.py\" hook",
            "timeout": 5,
            "statusMessage": "Loading plan review workflow"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/review.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/review.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/review.py\" hook",
            "timeout": 960,
            "statusMessage": "Checking plan review or reviewing submitted plan"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(worker|mechanical_worker)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/review.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/review.py\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
